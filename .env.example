# ─── API ─────────────────────────────────────────────────────
# Backend base URL.
# NOTE: Vite inlines VITE_* variables into the public JS bundle —
# never put secrets (passwords, private keys) in frontend env files.
VITE_API_URL=http://localhost:5001

# ─── Share links / channel previews ─────────────────────────
# Where the "Share" buttons send people. Leave EMPTY to use the API share card
# (VITE_API_URL + /s/menu), which shows the restaurant's real name + logo inside
# Facebook, Messenger, Telegram, WhatsApp, Instagram, WeChat, LinkedIn, X …
#
# Point it at your own domain once that domain proxies /s/* to the API
# (Render static site → Redirects/Rewrites → /s/* → https://<api-host>/s/*):
#   VITE_SHARE_BASE_URL=/s/menu
# Or set a full URL when the API lives somewhere else:
#   VITE_SHARE_BASE_URL=https://menu-restaurant-backend.onrender.com/s/menu
VITE_SHARE_BASE_URL=

# ─── Google Sign-In ─────────────────────────────────────────
# OAuth 2.0 Web Client ID from Google Cloud Console.
# Add http://localhost:5173 and your production URL to
# "Authorized JavaScript origins".
# Add http://localhost:5173/auth/google/callback and
# https://<your-domain>/auth/google/callback to
# "Authorized redirect URIs" (the custom button uses the OAuth popup flow).
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
